<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Syncfusion.Maui.Toolkit.GridSplitter.SfGridSplitterStyles"
             xmlns:gridSplitter="clr-namespace:Syncfusion.Maui.Toolkit.GridSplitter">

    <Style TargetType="gridSplitter:SfGridSplitter">
        <Setter Property="SeparatorBackground" Value="{DynamicResource SfGridSplitterSeparatorBackground}" />
        <Setter Property="ResizeIconColor" Value="{DynamicResource SfGridSplitterResizeIconColor}" />
        <Setter Property="ExpandCollapseIconColor" Value="{DynamicResource SfGridSplitterExpandCollapseIconColor}" />
    </Style>

</ResourceDictionary>
